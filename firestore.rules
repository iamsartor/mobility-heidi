rules_version = '2';
// Zugriff für jedes angemeldete Gerät. Die App meldet sich nach der PIN anonym an.
// In der Firebase-Konsole unter Firestore → Regeln einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{patientId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
